            "url": { "raw": "{{base_url}}/api/auth/account", "host": ["{{base_url}}"], "path": ["api", "auth", "account"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" }
          },
          "event": [
