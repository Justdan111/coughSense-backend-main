# Test environment configuration for the CoughSense backend test suite.
# Copy this file to .env.test (which is gitignored) and fill in real values.
#
# IMPORTANT: Use a DEDICATED Supabase test project, not your production project.
# The integration suite creates and deletes users on every run.
#
# In the Supabase test project:
#   - Disable "Confirm email" under Authentication → Providers → Email
#   - Create tables `profiles(user_id uuid pk, name text)` and `cough_samples(...)`
#   - Create a public storage bucket named `cough-data`
#   - Disable RLS for those tables, OR create policies that allow the test user
#     to insert/select/delete their own rows

# ----------------------------------------------------------------------
# Supabase test project — used by app/core/config.py at import time
# ----------------------------------------------------------------------
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_API_KEY=your-test-anon-key
SUPABASE_JWT_SECRET=your-test-jwt-secret

# ----------------------------------------------------------------------
# Service role key — required to delete test users between runs.
# If you leave this blank, the test_user fixture will skip user deletion
# and the integration suite will leave orphan users (named qa+ts={ts}@...)
# that you can purge manually from the Supabase dashboard.
# ----------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------
# Test user defaults — used when generating ephemeral test accounts
# ----------------------------------------------------------------------
TEST_USER_EMAIL_PREFIX=qa+coughsense
TEST_USER_PASSWORD=Test1234!Strong
TEST_USER_DOMAIN=example.com
